# AI Coding Agent — environment configuration
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Groq model to use. See https://console.groq.com/docs/models
# Popular options: llama-3.3-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
# Your Groq API key.
# Obtain one at https://console.groq.com/keys
# Must start with "gsk_".
GROQ_API_KEY=your_groq_api_key_here
